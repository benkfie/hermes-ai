{
  "name": "hermes-ai",
  "displayName": "Hermes AI Agent",
  "description": "VS Code extension for the Hermes AI agent. ACP-powered chat, settings management, tool execution, and multi-model support.",
  "version": "1.0.0",
  "publisher": "benkfie",
  "author": "benkfie",
  "license": "MIT",
  "keywords": [
    "ai agent",
    "coding assistant",
    "autonomous agent",
    "llm",
    "tool use",
    "chat",
    "hermes",
    "acp",
    "agent client protocol",
    "sidebar chat",
    "streaming"
  ],
  "homepage": "https://github.com/benkfie/hermes-ai",
  "bugs": {
    "url": "https://github.com/benkfie/hermes-ai/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/benkfie/hermes-ai.git"
  },
  "icon": "resources/hermes-logo-128.png",
  "galleryBanner": {
    "color": "#1f1f1f",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "categories": [
    "AI",
    "Chat",
    "Machine Learning",
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "qna": "https://github.com/joaompfp/hermes-vscode/issues",
  "contributes": {
    "commands": [
      {
        "command": "hermes.openChat",
        "title": "Hermes: Open Chat"
      },
      {
        "command": "hermes.newSession",
        "title": "Hermes: New Session"
      },
      {
        "command": "hermes.openSettings",
        "title": "Hermes: Open Settings"
      },
      {
        "command": "hermes.addToChat",
        "title": "Hermes: Add to Chat"
      },
      {
        "command": "hermes.explainCode",
        "title": "Hermes: Explain Code"
      },
      {
        "command": "hermes.fixCode",
        "title": "Hermes: Fix Code"
      },
      {
        "command": "hermes.improveCode",
        "title": "Hermes: Improve Code"
      },
      {
        "command": "hermes.addTerminalOutput",
        "title": "Hermes: Add Terminal Output to Chat"
      },
      {
        "command": "hermes.generateCommitMsg",
        "title": "Hermes: Generate Commit Message"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "hermes",
          "title": "Hermes Agent",
          "icon": "resources/hermes-icon.svg"
        }
      ]
    },
    "views": {
      "hermes": [
        {
          "type": "webview",
          "id": "hermes.chatView",
          "name": "Chat"
        },
        {
          "type": "webview",
          "id": "hermes.settingsView",
          "name": "Settings"
        }
      ]
    },
    "configuration": {
      "title": "Hermes",
      "properties": {
        "hermes.path": {
          "type": "string",
          "default": "hermes",
          "scope": "machine-overridable",
          "description": "Trusted absolute path to the Hermes binary."
        },
        "hermes.debugLogs": {
          "type": "boolean",
          "default": false,
          "description": "Enable diagnostic ACP logs in the Hermes output channel."
        },
        "hermes.autoConnect": {
          "type": "boolean",
          "default": true,
          "description": "Automatically connect to Hermes when VS Code starts"
        }
      }
    },
    "menus": {
      "editor/context": [
        {
          "command": "hermes.addToChat",
          "group": "Hermes@1",
          "when": "editorHasSelection"
        },
        {
          "command": "hermes.explainCode",
          "group": "Hermes@2",
          "when": "editorHasSelection"
        },
        {
          "command": "hermes.fixCode",
          "group": "Hermes@3",
          "when": "editorHasSelection"
        },
        {
          "command": "hermes.improveCode",
          "group": "Hermes@4",
          "when": "editorHasSelection"
        }
      ],
      "terminal/context": [
        {
          "command": "hermes.addTerminalOutput",
          "group": "Hermes@1"
        }
      ],
      "scm/title": [
        {
          "command": "hermes.generateCommitMsg",
          "group": "navigation@1"
        }
      ]
    },
    "keybindings": [
      {
        "command": "hermes.openChat",
        "key": "ctrl+`",
        "mac": "cmd+`"
      },
      {
        "command": "hermes.openSettings",
        "key": "ctrl+shift+`",
        "mac": "cmd+shift+`"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "webpack --mode production",
    "dev": "webpack --mode development --watch",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/dompurify": "^3.0.5",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.22.0",
    "ts-loader": "^9.5.0",
    "typescript": "^5.3.0",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "dompurify": "^3.3.3",
    "marked": "^17.0.5"
  }
}